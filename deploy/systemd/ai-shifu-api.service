# AI-Shifu Flask API (Python / gunicorn)
# Install: sudo cp deploy/systemd/ai-shifu-api.service /etc/systemd/system/
# Then edit User / paths to match your server before `systemctl daemon-reload`.
[Unit]
Description=AI-Shifu Flask API (gunicorn)
After=network.target mysql.service redis.service
Wants=mysql.service redis.service

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/home/ai-shifu-TTS/src/api
EnvironmentFile=/home/ai-shifu-TTS/src/api/.env
ExecStart=/home/ai-shifu-TTS/src/api/.venv/bin/gunicorn -w 4 -b 127.0.0.1:5800 --timeout 300 --access-logfile - --error-logfile - 'app:app'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
